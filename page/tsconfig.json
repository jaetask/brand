{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@shared/*": ["../src/shared/*"],
      "@shims/*": ["./shims/*"]
    }
  },
  "include": ["shell/**/*", "app/**/*", "shims/**/*"],
  "exclude": []
}
